# Application
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fairmate
SESSION_SECRET=replace-with-a-long-random-value
PORT=3000
# Set true to reject every paid-game admission before deposit or chain checks.
FAIRMATE_PRACTICE_ONLY=false
# Optional replacement storage, preferred over DATABASE_URL when nonempty.
# Paid play on replacement storage additionally requires the stake floor below.
FAIRMATE_RECOVERY_DATABASE_URL=
# Storage epoch floor: the first block whose entry stakes are admissible.
# Stakes mined in earlier blocks are refused, so a stake consumed under a
# previous database can never admit a second game. Mandatory for paid play on
# replacement storage; use a block strictly after the last one the previous
# storage could have served (current head + 1 at cutover). Malformed values
# fail closed.
FAIRMATE_STAKE_MIN_BLOCK=
# No game (practice included) opens while the referee wallet holds less 0G
# than this; anchors cost about 0.0004 0G each on Mainnet.
FAIRMATE_GAS_RESERVE_OG=0.1

# 0G production network
OG_CHAIN_NETWORK=mainnet
OG_COMPUTE_NETWORK=mainnet
OG_COMPUTE_TRANSPORT=router
OG_JOURNAL_ADDRESS=0x78718E892705129417636F70ceE11A97ca5AD726
OG_POT_ADDRESS=0x9BD5f06Ce7aB22dfF739Ed2b2886BfB49acc69Ef
OG_PROVIDER=0x1B3AAef3ae5050EEE04ea38cD4B087472BD85EB0

# Secrets, never commit real values
OG_ROUTER_API_KEY=
OG_WALLET_PRIVATE_KEY=