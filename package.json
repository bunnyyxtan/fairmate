{
  "name": "fairmate",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Chess vs an AI that provably can't cheat — TEE-attested moves on 0G Compute, hash-anchored on 0G Chain, with a real-stakes challenge pot bound to the on-chain game record",
  "repository": "github:bunnyyxtan/fairmate",
  "license": "MIT",
  "scripts": {
    "dev": "NODE_ENV=development tsx server/index.ts",
    "start": "NODE_ENV=production tsx server/index.ts",
    "build": "vite build",
    "compile": "tsx scripts/compile.ts",
    "deploy": "tsx scripts/deploy.ts",
    "drill": "tsx scripts/pot-drill.ts",
    "selfplay": "tsx scripts/selfplay-attested.ts",
    "verify": "tsx scripts/verify-evidence.ts",
    "balance": "tsx scripts/balance.ts",
    "services": "tsx scripts/list-services.ts",
    "test": "tsx --test server/**/*.test.ts src/**/*.test.ts shared/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.app.json --noEmit"
  },
  "dependencies": {
    "@0gfoundation/0g-compute-ts-sdk": "0.9.0",
    "chess.js": "^1.4.0",
    "ethers": "^6.17.0",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@radix-ui/react-collapsible": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.7",
    "@radix-ui/react-label": "^2.1.3",
    "@radix-ui/react-progress": "^1.1.3",
    "@radix-ui/react-scroll-area": "^1.2.4",
    "@radix-ui/react-separator": "^1.1.3",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-switch": "^1.1.4",
    "@radix-ui/react-tabs": "^1.1.4",
    "@radix-ui/react-toast": "^1.2.7",
    "@radix-ui/react-tooltip": "^1.2.0",
    "@tailwindcss/typography": "^0.5.15",
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.545.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "solc": "^0.8.36",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.2"
  }
}
